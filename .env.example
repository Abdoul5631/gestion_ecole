# Copier vers .env à la racine, puis redémarrer Django.
# Ne jamais y mettre de vrais secrets de production dans ce fichier d'exemple.

# Sécurité Django (valeurs locales OK pour XAMPP / Wend-Panga)
SECRET_KEY=changez-moi-en-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── MISE EN PRODUCTION ─────────────────────────────────────────────────────────
# DEBUG=False
# SECRET_KEY=<40 caractères aléatoires minimum>   (python -c "from django.core.management.utils import get_random_secret_key as g; print(g())")
# ALLOWED_HOSTS=ecole.exemple.bf                  (le domaine du site, jamais « * »)
# SITE_ORIGINS=https://ecole.exemple.bf           (adresse HTTPS du site, pour CORS et CSRF)
# Le serveur refuse de démarrer si SECRET_KEY ou ALLOWED_HOSTS sont dangereux. HTTPS, cookies sécurisés et HSTS sont activés.
# Surveillance : brancher un service (UptimeRobot, Better Stack…) sur https://<domaine>/api/sante/

# TCP obligatoire : ne pas mettre localhost (erreur MariaDB 1130).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gestion_ecole
DB_USER=root
DB_PASSWORD=

# Sans ces clés, les SMS restent simulés (file + notification in-app).
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=WendPanga
SMS_PROVIDER=generic
# SMS_USERNAME=
